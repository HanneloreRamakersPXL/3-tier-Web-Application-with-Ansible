# CineVote Backend — Runtime Configuration
# Generated by Ansible from roles/backend/templates/backend.env.j2
# Do NOT edit manually — changes will be overwritten on next deploy.

# ── Server ────────────────────────────────────────────────────
PORT={{ backend_port }}
NODE_ENV={{ backend_node_env }}

# ── Database (Storage Tier: {{ storage_ip }}) ─────────────────
DB_HOST={{ db_host }}
DB_PORT={{ db_port }}
DB_NAME={{ db_name }}
DB_USER={{ db_user }}
DB_PASSWORD={{ db_password }}

# ── CORS ──────────────────────────────────────────────────────
# Allow requests from the Nginx reverse-proxy origin
CORS_ORIGIN={{ cors_origin }}

# ── Authentication secrets (from Ansible Vault) ───────────────
JWT_SECRET={{ jwt_secret }}
HMAC_SECRET={{ hmac_secret }}

# ── External APIs ─────────────────────────────────────────────
TMDB_API_KEY={{ tmdb_api_key }}

# ── Application ───────────────────────────────────────────────
API_VERSION=1.0.0
