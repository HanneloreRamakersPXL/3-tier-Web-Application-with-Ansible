# CineVote — Nginx virtual host configuration
# Generated by Ansible from roles/frontend/templates/nginx.conf.j2
# Do NOT edit manually — changes will be overwritten on next deploy.
#
# Architecture:
#   Browser → Nginx ({{ frontend_ip }}:{{ frontend_port }})
#             ├─ /api/*        → Backend Node.js ({{ backend_ip }}:{{ backend_port }})
#             ├─ /socket.io/*  → Backend Socket.io ({{ backend_ip }}:{{ backend_port }})
#             └─ /*            → React SPA static files ({{ frontend_webroot }})

server {
    listen {{ frontend_port }};
    server_name _;

    root  {{ frontend_webroot }};
    index index.html;

    # ── Compression ───────────────────────────────────────────
    gzip            on;
    gzip_comp_level 4;
    gzip_types
        text/plain text/css text/xml
        application/json application/javascript
        application/xml+rss text/javascript;

    # ── API reverse proxy ─────────────────────────────────────
    # Forward /api/* to Node.js backend preserving the full path.
    # (backend mounts all routes under /api/, so the prefix must pass through)
    location /api/ {
        proxy_pass         http://{{ backend_ip }}:{{ backend_port }};
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 90s;
        proxy_connect_timeout 10s;
        proxy_send_timeout 90s;
    }

    # ── Socket.io WebSocket proxy ─────────────────────────────
    # socket.ts uses '' (same origin) in production → Nginx proxies here.
    location /socket.io/ {
        proxy_pass         http://{{ backend_ip }}:{{ backend_port }};
        proxy_http_version 1.1;
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        "upgrade";
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_read_timeout 86400s;    # keep WS connections alive
    }

    # ── Static assets — aggressive caching ───────────────────
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|map)$ {
        expires    7d;
        add_header Cache-Control "public, max-age=604800, immutable";
    }

    # ── React SPA — client-side routing fallback ──────────────
    # All unmatched paths return index.html so React Router works.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-store, no-cache, must-revalidate";
    }

    # ── Security headers ──────────────────────────────────────
    add_header X-Frame-Options        "SAMEORIGIN"                    always;
    add_header X-Content-Type-Options "nosniff"                       always;
    add_header Referrer-Policy        "strict-origin-when-cross-origin" always;
}
